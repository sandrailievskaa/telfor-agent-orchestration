{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ParsedIntent",
  "type": "object",
  "required": ["source_subnet", "dest_subnet", "dest_port", "protocol", "confidence"],
  "properties": {
    "source_subnet": { "type": "string" },
    "dest_subnet": { "type": "string" },
    "dest_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "protocol": { "type": "string", "enum": ["tcp", "udp", "icmp"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "ambiguous": { "type": "boolean" }
  }
}